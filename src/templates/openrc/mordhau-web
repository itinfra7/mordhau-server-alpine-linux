#!/sbin/openrc-run

name="mordhau-web"
description="MORDHAU management web server"

port_file="/root/mordhau/.manager/web-port"
trusted_proxy_file="/root/mordhau/.manager/trusted-proxies"
web_port="8080"
if [ -f "$port_file" ]; then
    web_port=$(sed -n '1p' "$port_file" | tr -d '\r\n')
fi

command="/root/mordhau/webserver.sh"
command_args="--port $web_port"
command_background="yes"
pidfile="/run/mordhau-web.pid"
directory="/root/mordhau"
output_log="/root/mordhau/.manager/runtime/web-service.log"
error_log="/root/mordhau/.manager/runtime/web-service.log"
retry="TERM/10/KILL/5"

depend() {
    need net
    after firewall
}

start_pre() {
    case "$web_port" in
        ''|*[!0-9]*)
            eerror "Invalid web port in $port_file"
            return 1
            ;;
    esac
    if [ "$web_port" -lt 1 ] || [ "$web_port" -gt 65535 ]; then
        eerror "Invalid web port in $port_file"
        return 1
    fi
    checkpath --directory --mode 0700 /root/mordhau/.manager/runtime
    checkpath --file --mode 0600 "$trusted_proxy_file"
}
